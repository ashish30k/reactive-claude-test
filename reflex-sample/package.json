{
  "name": "reflex-shop-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Shopify-style merchant admin app built with the Reflex architecture (headless core + JSON contract + CLI + dumb views).",
  "scripts": {
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "cli": "tsx cli/reflex-cli.ts",
    "host": "tsx host/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures:record": "tsx tools/record-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
